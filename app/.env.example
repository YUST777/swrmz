# SWRMZ desktop — copy to .env.local and fill in. .env.local is gitignored.

# Featherless AI (the only model provider). Get a key at:
# https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=
# Optional model override (defaults to Qwen/Qwen3-Coder-Next)
FEATHERLESS_MODEL=Qwen/Qwen3-Coder-Next

# Band coordination. The desktop Operator creates a fresh room per scan,
# recruits the three SWRMZ worker agents, and mirrors the room transcript.
# Create 4 Band remote agents: Operator, Analyst, Fixer, Reviewer.
BAND_OPERATOR_KEY=
BAND_ANALYST_KEY=
BAND_FIXER_KEY=
BAND_REVIEWER_KEY=

# Legacy fixed-room mirror. Optional; only used for manual chat mirroring.
BAND_API_KEY=
BAND_CHAT_ID=
# BAND_AGENT_BASE=https://app.band.ai/api/v1/agent
