# Copy to .env and fill in. .env is gitignored.

# Band platform (defaults are correct for the hosted platform)
BAND_REST_URL=https://app.band.ai/
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# LLM powering every remote Band agent.
# FEATHERLESS_* uses Featherless directly. AGENT_* can point to any
# OpenAI-compatible provider and takes precedence when set.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-Coder-Next
# AGENT_API_KEY=
# AGENT_BASE_URL=https://api.freemodel.dev/v1
# AGENT_MODEL=claude-sonnet-4-6
