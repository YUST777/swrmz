# Copy to .env and fill in. .env is gitignored.

# Band platform (defaults are correct for the hosted platform)
BAND_REST_URL=https://app.band.ai/
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Featherless = the LLM powering every agent
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-Coder-Next
